# SecureFlow Environment Configuration

# Server Port (Default: 5000)
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Database path (relative to server directory)
# Default: ./data/secureflow.db with SQLite WAL mode enabled
DATABASE_PATH=./data/secureflow.db

# Demo Mode Flag (enables evaluator quick-fill OTP chip in responses)
DEMO_ENVIRONMENT=true

# Security Rate Limiting
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
